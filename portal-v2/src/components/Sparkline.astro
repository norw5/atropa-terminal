---
interface Point { x: number; y: number; label?: string }
interface Props {
  points: Point[];
  width?: number;
  height?: number;
  yFmt?: (n: number) => string;
  stroke?: string;
  fill?: string;
}
const {
  points,
  width = 860,
  height = 180,
  yFmt = (n: number) => String(Math.round(n)),
  stroke = 'var(--accent)',
  fill = 'rgba(89, 240, 162, 0.10)',
} = Astro.props;

const pad = { l: 52, r: 10, t: 10, b: 18 };
const iw = width - pad.l - pad.r;
const ih = height - pad.t - pad.b;
const ys = points.map((p) => p.y);
const ymin = Math.min(...ys, 0);
const ymax = Math.max(...ys) || 1;
const sx = (i: number) => pad.l + (points.length > 1 ? (i / (points.length - 1)) * iw : iw / 2);
const sy = (v: number) => pad.t + ih - ((v - ymin) / (ymax - ymin || 1)) * ih;
const path = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${sx(i).toFixed(1)},${sy(p.y).toFixed(1)}`).join(' ');
const area = `${path} L${sx(points.length - 1).toFixed(1)},${(pad.t + ih).toFixed(1)} L${sx(0).toFixed(1)},${(pad.t + ih).toFixed(1)} Z`;
const ticks = [ymax, ymin + (ymax - ymin) / 2, ymin];
---
<svg class="spark" viewBox={`0 0 ${width} ${height}`} width="100%" role="img">
  {ticks.map((t) => (
    <g>
      <line x1={pad.l} x2={width - pad.r} y1={sy(t)} y2={sy(t)} stroke="var(--border)" stroke-width="1" />
      <text x={pad.l - 6} y={sy(t) + 3} text-anchor="end">{yFmt(t)}</text>
    </g>
  ))}
  <path d={area} fill={fill} />
  <path d={path} fill="none" stroke={stroke} stroke-width="1.5" />
  {points[0]?.label && <text x={pad.l} y={height - 4}>{points[0].label}</text>}
  {points[points.length - 1]?.label && (
    <text x={width - pad.r} y={height - 4} text-anchor="end">{points[points.length - 1].label}</text>
  )}
</svg>
