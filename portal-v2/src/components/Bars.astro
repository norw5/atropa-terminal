---
interface Bar { label: string; value: number; title?: string }
interface Props {
  bars: Bar[];
  width?: number;
  height?: number;
  color?: string;
  yFmt?: (n: number) => string;
}
const {
  bars,
  width = 860,
  height = 160,
  color = 'var(--accent)',
  yFmt = (n: number) => String(n),
} = Astro.props;
const pad = { l: 52, r: 10, t: 8, b: 30 };
const iw = width - pad.l - pad.r;
const ih = height - pad.t - pad.b;
const ymax = Math.max(...bars.map((b) => b.value), 1);
const bw = Math.max(1, iw / bars.length - (bars.length > 1 ? 1.5 : 0));
const step = Math.max(1, Math.ceil(bars.length / 24));
---
<svg class="spark" viewBox={`0 0 ${width} ${height}`} width="100%" role="img">
  {[ymax, ymax / 2, 0].map((t) => (
    <g>
      <line x1={pad.l} x2={width - pad.r} y1={pad.t + ih - (t / ymax) * ih} y2={pad.t + ih - (t / ymax) * ih} stroke="var(--border)" />
      <text x={pad.l - 6} y={pad.t + ih - (t / ymax) * ih + 3} text-anchor="end">{yFmt(t)}</text>
    </g>
  ))}
  {bars.map((b, i) => {
    const h = (b.value / ymax) * ih;
    const x = pad.l + (i / bars.length) * iw;
    return (
      <rect
        x={x}
        y={pad.t + ih - h}
        width={bw}
        height={Math.max(h, b.value > 0 ? 1 : 0)}
        fill={color}
      >
        <title>{b.title || `${b.label}: ${b.value}`}</title>
      </rect>
    );
  })}
  {bars.map((b, i) =>
    i % step === 0 ? (
      <text x={pad.l + (i / bars.length) * iw + bw / 2} y={height - 16} text-anchor="middle">{b.label.slice(2)}</text>
    ) : null,
  )}
</svg>
