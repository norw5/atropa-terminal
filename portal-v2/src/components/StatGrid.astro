---
interface Stat {
  v: string;
  k: string;
  sub?: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<div class="statgrid">
  {stats.map((s) => (
    <div class="stat">
      <div class="v">{s.v}</div>
      <div class="k">{s.k}</div>
      {s.sub && <div class="sub">{s.sub}</div>}
    </div>
  ))}
</div>
