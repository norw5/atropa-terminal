---
import Base from '../layouts/Base.astro';
import { loadTaxonomy, loadRegistry } from '../lib/data';

const tax = loadTaxonomy();
const registry = loadRegistry();
const counts: Record<string, number> = tax._meta.counts;
const dims: Record<string, string> = tax._meta.dimensions ?? {};
const dimRows = Object.entries(dims).filter(([k]) => k.startsWith('tax_'));
const actors: { address: string; label: string; roles: string[] }[] = tax._meta.known_actors ?? [];

function colName(field: string): string {
  const vals = new Set<string>();
  for (const t of tax.tokens) if (t[field] && typeof t[field] === 'string') vals.add(t[field]);
  if (vals.size) return [...vals].sort().join(' · ');
  return '';
}

const registryByClass: Record<string, any[]> = {};
for (const r of registry) (registryByClass[r.tax_class] ||= []).push(r);
---

<Base title="taxonomy" active="taxonomy">
  <h1>taxonomy <span class="dim">— semantics-derived, machine-computed</span></h1>
  <p class="dim">
    Classes are defined by objective, data-derivable rules — never by
    community-list membership. Maria authorship is the core/community filter
    (<code>tax_origin</code>), not a class. Rules:&nbsp;
    <code>{tax._meta.rules_version}</code>; the classifier self-test
    re-derives all counts from the merged census on every regeneration
    (machine fields ship in <a href="/data/taxonomy.compact.json">the taxonomy bundle</a>).
  </p>

  <div class="panel">
    <h2>Principal classes <span class="dim">(census {tax._meta.census_rows} + registry {registry.length})</span></h2>
    <table class="sortable">
      <thead><tr><th>class</th><th class="num">entities</th></tr></thead>
      <tbody>
        {Object.entries(counts).sort((a, [b]: any) => b[1] - a[1]).map(([cls, n]) => (
          <tr>
            <td>
              {cls.endsWith('-tt')
                ? <a href={`/tokens?cls=${cls}`}>{cls}</a>
                : <a href={`/contracts`}>{cls}</a>}
              {registryByClass[cls] && <span class="badge">registry</span>}
            </td>
            <td class="num">{(n as number).toLocaleString()}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="panel">
    <h2>Known actors <span class="dim">(functional attribution only — no identity claims)</span></h2>
    <table class="sortable">
      <thead><tr><th>actor</th><th>address</th><th>functional roles [chain]/[src]</th></tr></thead>
      <tbody>
        {actors.map((a) => (
          <tr>
            <td class="wrapok">{a.label}</td>
            <td class="mono xs">{a.address}</td>
            <td class="wrapok">
              <ul style="margin:0;padding-left:1rem">
                {a.roles.map((r) => <li>{r}</li>)}
              </ul>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="dim" style="font-size:0.8rem">
      The set is extensible — newly identified wallets join here without structural
      change (deploy facts, not identity, drive everything downstream).
    </p>
  </div>

  <div class="panel">
    <h2>The eight dimensions + filters</h2>
    <table class="sortable">
      <thead><tr><th>field</th><th>rule (machine)</th></tr></thead>
      <tbody>
        {dimRows.map(([f, rule]) => (
          <tr>
            <td class="nowrap"><code>{f}</code></td>
            <td>{rule}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="panel">
    <h2>Registry contracts (classified)</h2>
    <table class="x-table sortable">
      <thead><tr><th>label</th><th>class</th><th>admin</th><th>era</th><th>origin</th><th>address</th></tr></thead>
      <tbody>
        {registry.slice(0, 400).map((r) => (
          <tr>
            <td class="wrapok"><a href={`/contracts/${r.address.toLowerCase()}`}>{r.label || '(unnamed)'}</a></td>
            <td>{r.tax_class}</td>
            <td>{r.tax_admin}</td>
            <td>{r.tax_era}</td>
            <td>{r.tax_origin}</td>
            <td class="mono xs"><a href={`/contracts/${r.address.toLowerCase()}`}>{r.address}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
