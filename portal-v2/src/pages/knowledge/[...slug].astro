---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtNum, fmtInt, fmtDate } from '../../lib/fmt';
import {
  loadTokensFull, loadActivity, loadClaims, loadClaimsByEntity, loadRegistry,
  loadExtractable, loadV1Sink, loadActivityPerToken, loadSharedInfra, readTshareAudit,
  buildChildrenMap, loadAdminSurface,
} from '../../lib/data';

export async function getStaticPaths() {
  const docs = await getCollection('kbv2');
  return docs.map((d) => ({
    params: { slug: d.id.replace(/\.md$/, '').replace(/\/readme$/i, '') },
    props: { doc: d },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const path = doc.id.replace(/\.md$/, '').replace(/(^|\/)README$/, '$1index');

const MINTERS: Record<string, { label: string; ver: string; addr: string }> = {
  'mechanics/v1-tbillminter': { label: 'V1 TbillMinter', ver: 'V1', addr: '0xc7bdac3e6bb5ec37041a11328723e9927ccf430b' },
  'mechanics/v2-federalminter': { label: 'V2 FederalMinter', ver: 'V2', addr: '0xc15c5f699daf5e1135732139f05d2c05b3ef4354' },
  'mechanics/v3-indexminter': { label: 'V3 IndexMinter', ver: 'V3', addr: '0x0c4f73328dfcecfbecf235c9f78a4494a7ec5ddc' },
  'mechanics/v4-personalminter': { label: 'V4 PersonalMinter', ver: 'V4', addr: '0x394c3d5990cefc7be36b82fdb07a7251ace61cc7' },
};
const minter = MINTERS[path] ?? null;
const isBureau = path === 'mechanics/bureau-minters';
const isLiquidity = path === 'reference/liquidity';
const isAdmin = path === 'reference/admin-surface';
const isDeep = path.startsWith('deep/');

const DEEP_REGISTRY: Record<string, string[]> = {
  'deep/fed': ['0x1d177cb9efeea49a8b97ab1c72785a3a37abc9ff'],
  'deep/tbill': ['0x463413c579d29c26d59a65312657dfce30d545a1'],
  'deep/mv': ['0xa1bee1dae9af77dac73aa0459ed63b4d93fc6d29'],
  'deep/math-family': [
    '0xb680f0cc810317933f234f67eb6a9e923407f05d', '0xa96bcbed7f01de6ceed14fc86d90f21a36de2143',
    '0x5ef3011243b03f817223a19f277638397048a0dc', '0x232a27ab6941281b3f474fe5ff7cc89816fb675a',
    '0x73a19fafb359faf519c9707b781dfdb88407d10d', '0x2fc636e7fdf9f3e8d61033103052079781a6e7d2',
    '0xa2262d7728c689526693ae893d0fd8a352c7073c',
  ],
  'deep/keys-of-ong': ['0x9ccc2de565da893ab1300674f174545a3e568f93'],
  'deep/teddybear': ['0xd6c31ba0754c4383a41c0e9df042c62b5e918f6d'],
  'deep/atropa': ['0xcc78a0acdf847a2c1714d2a925bb4477df5d48a6'],
  'deep/fdic-poor-spines': [
    '0x812571a12330a74e2a3c1ff8953f6f3aac7a83e9', '0xaa1505c928fd85e10a550cfde9e8f464c3574d8a',
    '0x51160f352ed148c89d48dfe6384edd07afa24e0e', '0xe37acc54711562510fafc45d8199ee329ebbcedd',
    '0xc7145e1290b1d1221aba5ae48d4ace17c6be088f', '0x0b92ad7ed0da6c44bf71b3fcee668d1670000ff5',
  ],
};

interface DeepRow {
  addr: string; reg: any; tok: any; act: any; kids: number; claims: string[];
}
let deepRows: DeepRow[] = [];
let deepKidsOf: { addr: string; n: number; top: string[] } | null = null;
let deepSink: any = null;
let deepMv: any = null;
let deepSharedInfra: any = null;
let deepMathlib: any = null;
let deepKongSupply: string | null = null;
if (isDeep) {
  const addrs = DEEP_REGISTRY[path] ?? [];
  const regBy = new Map(loadRegistry().map((r: any) => [r.address.toLowerCase(), r]));
  const tokBy = new Map(loadTokensFull().map((t: any) => [t.address.toLowerCase(), t]));
  const actBy = loadActivityPerToken();
  const claimsBy = loadClaimsByEntity();
  const childrenMap = buildChildrenMap(loadTokensFull());
  deepRows = addrs.map((a) => ({
    addr: a, reg: regBy.get(a) ?? null, tok: tokBy.get(a) ?? null,
    act: actBy[a] ?? null, kids: childrenMap.get(a)?.length ?? 0,
    claims: claimsBy[a] ?? [],
  }));
  if (path === 'deep/fed' || path === 'deep/tbill') {
    const parent = path === 'deep/fed' ? '0x1d177cb9efeea49a8b97ab1c72785a3a37abc9ff' : '0x463413c579d29c26d59a65312657dfce30d545a1';
    const kids = childrenMap.get(parent) ?? [];
    deepKidsOf = { addr: parent, n: kids.length, top: kids.slice(-5).reverse().map((k: any) => String(k.name_clean || k.name || k.symbol || k.address.slice(0, 8)).slice(0, 40)) };
  }
  if (path === 'deep/tbill') deepSink = loadV1Sink();
  if (path === 'deep/mv') deepMv = loadActivity().mv_accrual ?? null;
  if (path === 'deep/math-family') {
    deepSharedInfra = loadSharedInfra();
    deepMathlib = loadActivity().mathlib_usage ?? null;
  }
  if (path === 'deep/keys-of-ong') {
    const tv = readTshareAudit();
    const kong = tv.find((r: any) => r.address.toLowerCase() === '0x9ccc2de565da893ab1300674f174545a3e568f93');
    deepKongSupply = kong?.supply != null ? (Number(BigInt(kong.supply) / 10n ** 12n) / 1e6).toString() : null;
  }
}

let kids: any[] = [];
let eraHist: [string, number][] = [];
let topCreators: [string, number][] = [];
let mvRevenue: any = null;
let publishRow: any = null;
let claimIds: string[] = [];
if (minter || isBureau) {
  const vers = minter ? [minter.ver] : ['BureauMinter#1'];
  const tokens = loadTokensFull();
  kids = tokens.filter((t: any) => (minter ? t.minter_version === minter.ver : String(t.minter_version).startsWith('Bureau')));
  const eras: Record<string, number> = {};
  for (const k of kids) eras[k.tax_era] = (eras[k.tax_era] ?? 0) + 1;
  eraHist = Object.entries(eras).sort((a, b) => b[1] - a[1]);
  const creators: Record<string, number> = {};
  for (const k of kids) creators[k.creator] = (creators[k.creator] ?? 0) + 1;
  topCreators = Object.entries(creators).sort((a, b) => b[1] - a[1]).slice(0, 8);
  const am = loadActivity();
  const key = minter?.ver ?? 'Bureau#1';
  mvRevenue = am.mv_accrual?.per_minter?.[key] ?? null;
  if (minter?.ver === 'V2') publishRow = am.publish_adoption ?? null;
  const claimsBy = loadClaimsByEntity();
  const addr = minter?.addr ?? '0xc4f0ce2b0ffa0063b763e2b6c124a1d80e0641b5';
  claimIds = claimsBy[addr] ?? [];
}
let sink: any = null;
let sinkClaimId: string | null = null;
if (minter?.ver === 'V1') {
  sink = loadV1Sink();
  sinkClaimId = (loadClaims().find((c: any) => c.statement?.startsWith('V1 permanently locked')) ?? {}).id ?? null;
}

let classLiq: any[] = [];
let burnt: any = null;
let numeraires: any[] = [];
if (isLiquidity) {
  const tokens = loadTokensFull();
  const agg: Record<string, any> = {};
  for (const t of tokens) {
    const c = t.tax_class;
    agg[c] ??= { n: 0, live: 0, dead: 0, paper: 0, burnt: 0 };
    agg[c].n += 1;
    if (t.tax_liquidity === 'pooled-live') agg[c].live += 1;
    else if (t.tax_liquidity === 'pooled-dead-all') agg[c].dead += 1;
    else agg[c].paper += 1;
    if ((t.tax_liq_flags ?? []).includes('burnt-locked-50')) agg[c].burnt += 1;
  }
  classLiq = Object.entries(agg).map(([cls, v]: any) => ({ cls, ...v })).sort((a, b) => b.n - a.n);
  burnt = loadExtractable();
  numeraires = loadRegistry().filter((r: any) => ['forked-asset', 'bridge-asset', 'reserve-asset', 'payment-asset'].includes(r.tax_class));
}

interface AdminRow {
  addr: string; label: string; owner_kind: string; owner: string; caps: string; gates: string[];
  taxClass: string; taxOrigin: string;
}
let adminKinds: { kind: string; n: number }[] = [];
let adminCaps: { caps: string; n: number }[] = [];
let adminNotable: AdminRow[] = [];
let adminBlock: number | null = null;
if (isAdmin) {
  const surf = loadAdminSurface();
  adminBlock = surf._meta?.block ?? null;
  const byKind: Record<string, number> = {};
  const byCaps: Record<string, number> = {};
  for (const v of Object.values<any>(surf.contracts)) {
    byKind[v.owner_kind] = (byKind[v.owner_kind] ?? 0) + 1;
    byCaps[v.caps ?? 'unknown'] = (byCaps[v.caps ?? 'unknown'] ?? 0) + 1;
  }
  const kindLabel: Record<string, string> = {
    maria2: 'Maria #2 (the dev)', maria1: 'Maria #1', trebizond: 'trebizond wallet',
    'independence-contract': 'INDEPENDENCE contract', 'community-builder': 'community tooling builder',
    'third-party': 'other third parties', 'burn-sink': 'burn sinks (dead / 0x01)',
    'bridge-operator': 'official bridge operator', renounced: 'renounced (owner == 0x0)',
    none: 'no owner function', error: 'probe error',
  };
  adminKinds = Object.entries(byKind).map(([k, n]) => ({ kind: kindLabel[k] ?? k, n })).sort((a, b) => b.n - a.n);
  adminCaps = Object.entries(byCaps).map(([c, n]) => ({ caps: c, n })).sort((a, b) => b.n - a.n);
  const regBy = new Map(loadRegistry().map((r: any) => [r.address.toLowerCase(), r]));
  const INTERESTING = new Set(['owner-mint', 'owner-withdraw', 'owner-pausable-withdraw', 'governance', 'inert-rescue-open']);
  for (const [a, v] of Object.entries<any>(surf.contracts)) {
    const live = !['renounced', 'none', 'error', ''].includes(v.owner_kind);
    const interesting = INTERESTING.has(v.caps ?? '') || (live && v.owner_kind !== 'maria2');
    if (!interesting) continue;
    const reg = regBy.get(a);
    adminNotable.push({
      addr: a,
      label: (reg?.label || v.label || a.slice(0, 12)).toString().slice(0, 40),
      owner_kind: v.owner_kind, owner: v.owner ?? '',
      caps: v.caps ?? 'unknown',
      gates: (v.owner_gated ?? []).slice(0, 6),
      taxClass: reg?.tax_class ?? '—',
      taxOrigin: reg?.tax_origin ?? '—',
    });
  }
  adminNotable.sort((a, b) => (a.caps === b.caps ? a.label.localeCompare(b.label) : a.caps.localeCompare(b.caps)));
}
---

<Base title={path} active="knowledge">
  <div class="prose">
    <Content />
  </div>

  {isDeep && deepRows.length > 0 && (
    <div class="panel">
      <h2>generated state <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(data layer: registry + census snapshot + event study — no hand-written numbers)</span></h2>
      <table class="sortable">
        <thead><tr><th>entity</th><th>deploy</th><th class="num">supply (snap)</th><th>parent custody</th><th class="num">mints / claims</th><th class="num">WPLS liq.</th><th>links</th></tr></thead>
        <tbody>
          {deepRows.map((r: any) => (
            <tr>
              <td class="wrapok">
                {r.reg ? <a href={`/contracts/${r.addr}`}>{r.reg.label || r.addr.slice(0, 12)}</a>
                  : r.tok ? <a href={`/tokens/${r.addr}`}>{r.tok.name_clean || r.tok.name || r.addr.slice(0, 12)}</a>
                  : <span class="mono xs">{r.addr.slice(0, 12)}…</span>}
                {r.kids > 0 && <span class="badge">{r.kids} census children</span>}
              </td>
              <td class="mono xs">{r.reg?.block ? `blk ${fmtInt(r.reg.block)}` : r.tok?.block ? `blk ${fmtInt(r.tok.block)}` : '—'}</td>
              <td class="num">{r.tok?.totalSupply_snap != null ? fmtNum(Number(r.tok.totalSupply_snap) / 10 ** (r.tok.decimals ?? 18), 0) : deepKongSupply && r.addr === '0x9ccc2de565da893ab1300674f174545a3e568f93' ? fmtInt(deepKongSupply) : '—'}</td>
              <td class="num">{r.tok?.custody_parent != null && Number(r.tok.custody_parent) > 0 ? `${fmtNum(Number(r.tok.custody_parent) / 10 ** 18, 0)} (${r.tok.backing_ratio > 10 ? fmtNum(r.tok.backing_ratio, 0) + '× supply' : (100 * r.tok.backing_ratio).toFixed(0) + '%'})` : r.tok ? '0 — drained/none' : '—'}</td>
              <td class="num">{(r.act?.n_mint ?? r.act?.recovery?.n) != null ? `${fmtInt(r.act.n_mint ?? 0)} / ${fmtInt(r.act.recovery?.n ?? 0)}` : r.addr === '0x812571a12330a74e2a3c1ff8953f6f3aac7a83e9' ? 'n/a — spam era (unscannable)' : '—'}</td>
              <td class="num">{r.reg?.liquidity ? fmtNum(r.reg.liquidity.w, 1) : '—'}</td>
              <td class="mono xs">
                <a href={`https://ipfs.scan.pulsechain.com/address/${r.addr}`}>explorer</a>
                {r.claims.length > 0 && <> · <a href={`/claims`}>{r.claims.length} claims</a></>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {deepKidsOf && (
        <p class="mono xs" style="color:var(--fg-faint)">
          census children with this parent: {fmtInt(deepKidsOf.n)} (recent:&nbsp;
          {deepKidsOf.top.join(' · ')}) [chain]
        </p>
      )}
      {deepSink && (
        <p class="mono xs" style="color:var(--fg-faint)">
          V1 TBILL sink: {fmtNum(Number(deepSink.total_raw) / 1e18, 2)} TBILL locked in {deepSink.nonzero}/167 V1 children — no exit path [chain]
        </p>
      )}
      {deepMv && (
        <p class="mono xs" style="color:var(--fg-faint)">
          MV accrual: {fmtNum(deepMv.total_accrued_approx, 2)} MV over {fmtInt(deepMv.total_payments)} payments · top payer {fmtNum(deepMv.top_payers?.[0]?.value_approx ?? 0, 1)} MV ({Math.round(100 * (deepMv.top_payers?.[0]?.value_approx ?? 0) / deepMv.total_accrued_approx)}%) [chain]
        </p>
      )}
      {deepSharedInfra && (
        <table class="sortable">
          <thead><tr><th>family member</th><th>supply (units)</th><th>owner @ blk {fmtInt(deepSharedInfra._meta?.state_block)}</th></tr></thead>
          <tbody>
            {Object.values<any>(deepSharedInfra.family).map((f: any) => (
              <tr>
                <td class="wrapok"><a href={`/contracts/${f.address.toLowerCase()}`}>{f.label}</a></td>
                <td class="num">{fmtNum(f.totalSupply_units, 0)}</td>
                <td>{f.owner_is_maria2 ? <span class="badge">Maria #2 — functionally inert</span> : f.owner_is_zero ? 'renounced' : <span class="mono xs">{f.owner.slice(0, 12)}…</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      {deepMathlib && (
        <p class="mono xs" style="color:var(--fg-faint)">
          Random() call volume: {fmtInt(deepMathlib.MATH?.mints_total ?? 0)} all-time [chain] — curve on /shared-infra
        </p>
      )}
    </div>
  )}

  {(minter || isBureau) && (
    <div class="panel">
      <h2>generated census statistics <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(rule: every child of the factory in the census — no selection)</span></h2>
      <dl class="kv">
        <dt>children</dt><dd>{fmtInt(kids.length)} — every row RPC-verified, entity-paged under /tokens</dd>
        <dt>era mix</dt><dd>{eraHist.map(([e, n]) => `${e} ${n.toLocaleString()}`).join(' · ')}</dd>
        <dt>top creators</dt>
        <dd class="mono xs">
          {topCreators.map(([c, n], i) => (
            <span>{i > 0 && ' · '}{c ? <a href={`https://ipfs.scan.pulsechain.com/address/${c}`}>{c.slice(0, 10)}…</a> : '—'} ×{n.toLocaleString()}</span>
          ))}
          <div style="color:var(--fg-faint)">rule: top 8 EOAs by direct children created through this factory [chain]</div>
        </dd>
        {mvRevenue && <dt>MV revenue</dt>}
        {mvRevenue && <dd>{fmtNum(mvRevenue.accrued_total_approx, 2)} MV over {fmtInt(mvRevenue.payments)} payments (blocks {fmtInt(mvRevenue.first_block)}–{fmtInt(mvRevenue.last_block)})</dd>}
        {publishRow && <dt>publish adoption</dt>}
        {publishRow && <dd>{fmtInt(publishRow.distinct_published_addresses)} of {fmtInt(publishRow.census_v2_total)} census-era V2 children ever published ({(100 * publishRow.distinct_published_addresses / publishRow.census_v2_total).toFixed(1)}%); first publish block {fmtInt(publishRow.first_publish?.block)}</dd>}
        <dt>claims</dt>
        <dd>{claimIds.length} registered claim-classes touch this factory: {claimIds.map((id) => <a href={`/claims#${id}`}>{id} </a>)}</dd>
      </dl>
    </div>
  )}

  {minter?.ver === 'V1' && sink && (
    <div class="panel">
      <h2>V1 TBILL sink (generated)</h2>
      <dl class="kv">
        <dt>locked forever</dt><dd>{fmtNum(Number(sink.total_raw) / 1e18, 2)} TBILL across {sink.nonzero} of 167 children — no exit path exists in any V1 bytecode {sinkClaimId && <>· <a href={`/claims#${sinkClaimId}`}>{sinkClaimId}</a></>}</dd>
        <dt>largest holders of sink</dt>
        <dd class="mono xs">{(sink.top ?? []).slice(0, 5).map((x: any, i: number) => (
          <span>{i > 0 && ' · '}<a href={`/tokens/${x.address.toLowerCase()}`}>{x.address.slice(0, 10)}…</a> {fmtNum(Number(x.raw) / 1e18, 1)}</span>
        ))}</dd>
        <dt>tip block</dt><dd>{fmtInt(sink._meta?.tip_block)}</dd>
      </dl>
    </div>
  )}

  {isLiquidity && (
    <>
      <div class="panel">
        <h2>liquidity reality by taxonomy class <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(generated — census × crawl)</span></h2>
        <table class="sortable">
          <thead><tr><th>class</th><th class="num">entities</th><th class="num">pooled-live</th><th class="num">pooled-dead-all</th><th class="num">spine-only-paper</th><th class="num">burnt-50 flag</th></tr></thead>
          <tbody>
            {classLiq.map((c: any) => (
              <tr><td>{c.cls}</td><td class="num">{fmtInt(c.n)}</td><td class="num">{fmtInt(c.live)}</td><td class="num">{fmtInt(c.dead)}</td><td class="num">{fmtInt(c.paper)}</td><td class="num">{fmtInt(c.burnt)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      {burnt && (
        <div class="panel">
          <h2>burnt-LP census (generated)</h2>
          <dl class="kv">
            <dt>pairs ≥50% burnt</dt><dd>{fmtInt(burnt.pairs_ge50_burnt)} of {fmtInt(burnt._meta.n_pairs)} ({(100 * burnt.pairs_ge50_burnt / burnt._meta.n_pairs).toFixed(1)}%)</dd>
            <dt>any dead-sink LP</dt><dd>{fmtInt(burnt.pairs_any_burnt)}</dd>
            <dt>WPLS locked behind burnt LP</dt><dd>{fmtNum(burnt.wpls_locked_behind_burnt_lp)} WPLS (0.8% of WPLS-leg reserves)</dd>
            <dt>caveat</dt><dd class="dim">{burnt._meta.caveat}</dd>
          </dl>
        </div>
      )}
      <div class="panel">
        <h2>numeraire classes (generated registry slice)</h2>
        <table class="sortable">
          <thead><tr><th>class</th><th>label</th><th>address</th><th>liquidity</th></tr></thead>
          <tbody>
            {numeraires.map((r: any) => (
              <tr><td><span class="tag">{r.tax_class}</span></td><td class="wrapok"><a href={`/contracts/${r.address.toLowerCase()}`}>{r.label}</a></td><td class="mono xs">{r.address}</td><td>{r.liquidity ? fmtNum(r.liquidity.w, 1) + ' WPLS' : '—'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {isAdmin && (
    <>
      <div class="panel">
        <h2>owner census <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(generated — one owner() eth_call per registry contract{adminBlock ? ` @ block ${fmtInt(adminBlock)}` : ''})</span></h2>
        <table class="sortable">
          <thead><tr><th>owner</th><th class="num">contracts</th></tr></thead>
          <tbody>
            {adminKinds.map((k) => (
              <tr><td>{k.kind}</td><td class="num">{fmtInt(k.n)}</td></tr>
            ))}
          </tbody>
        </table>
        <table class="sortable" style="margin-top:1rem">
          <thead><tr><th>capability</th><th class="num">contracts</th></tr></thead>
          <tbody>
            {adminCaps.map((c) => (
              <tr><td><span class="tag">{c.caps}</span></td><td class="num">{fmtInt(c.n)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="panel">
        <h2>live keys with real powers, and every non-dev owner <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(generated — capability census; full table in the data layer)</span></h2>
        <table class="sortable">
          <thead><tr><th>contract</th><th>class</th><th>origin</th><th>capability</th><th>owner</th><th>owner-gated functions</th></tr></thead>
          <tbody>
            {adminNotable.map((r: AdminRow) => (
              <tr>
                <td class="wrapok"><a href={`/contracts/${r.addr}`}>{r.label}</a></td>
                <td><span class="tag">{r.taxClass}</span></td>
                <td>{r.taxOrigin === 'core' ? <span class="badge">core</span> : r.taxOrigin}</td>
                <td><span class="tag">{r.caps}</span></td>
                <td class="mono xs">{r.owner_kind === 'renounced' ? '0x0' : r.owner ? `${r.owner.slice(0, 12)}…` : '—'}</td>
                <td class="mono xs">{r.gates.length ? r.gates.join(' · ') : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</Base>
