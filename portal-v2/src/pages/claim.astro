---
import Base from '../layouts/Base.astro';

const V2_MINTER = '0xc15c5f699daf5e1135732139f05d2c05b3ef4354';
const V3_MINTER = '0x0c4f73328dfcecfbecf235c9f78a4494a7ec5ddc';
const V1_MINTER = '0xc7bdac3e6bb5ec37041a11328723e9927ccf430b';
---

<Base title="claim" active="claim">
  <h1><span style="color:var(--fg-faint)">exec</span> /claim — claim locked collateral &amp; publish</h1>
  <p style="color:var(--fg-dim);max-width:64rem">
    Pure client-side tool: your injected wallet calls the treasury tokens&nbsp;
    <b>directly</b> — no server, no keys, no third-party contract in the path
    (helpers are <a href="/contracts">studied but never integrated</a>).
    A <b>claim</b> surrenders a claim key and receives the payout token's
    locked <b>parent collateral 1:1</b>&nbsp;
    (<span class="mono xs">Recovery(Client, Contract, Amount)</span>) — the
    exact inverse of <span class="mono xs">mint()</span>. <b>Publish</b>&nbsp;
    exists only on V2 children. Every effect below is previewed&nbsp;
    <b>before</b> the tx, from the corrected reference semantics
    (<a href="/knowledge/mechanics/claim-and-publish/">claim &amp; publish</a>).
  </p>

  <div class="panel">
    <div class="x-controls">
      <button id="w-connect" class="pgbtn">connect wallet</button>
      <span id="w-status" class="mono xs" style="color:var(--fg-faint)">not connected</span>
    </div>
  </div>

  <div class="panel">
    <div class="x-controls">
      <button id="mode-claim" class="pgbtn mode active">claim / self-redeem</button>
      <button id="mode-publish" class="pgbtn mode">publish (V2)</button>
    </div>

    <div id="pane-claim" class="pane">
      <div class="x-controls">
        <label class="flabel">payout token</label>
        <input type="text" id="cl-token" placeholder="search 3,129 census tokens by name / symbol / address… (the token whose locked parent pays out)" style="min-width:420px" />
        <div id="cl-token-list" class="picklist"></div>
      </div>
      <div id="cl-facts" class="kv" style="margin:0.6rem 0"></div>
      <div id="cl-warn" class="note" style="display:none"></div>
      <div class="x-controls" id="cl-key-row">
        <label class="flabel">claim key</label>
        <input type="text" id="cl-key" placeholder="the token you surrender — search census or paste 0x…" style="min-width:420px" />
        <div id="cl-key-list" class="picklist"></div>
      </div>
      <div id="cl-keyfacts" class="kv" style="margin:0.6rem 0"></div>
      <div class="x-controls">
        <label class="flabel">amount</label>
        <input type="text" id="cl-amount" placeholder="100" style="min-width:140px" />
        <span id="cl-preview" class="mono xs"></span>
      </div>
      <div class="x-controls">
        <button id="cl-go" class="pgbtn">approve key &amp; claim</button>
      </div>
    </div>

    <div id="pane-publish" class="pane" style="display:none">
      <div class="x-controls">
        <label class="flabel">token</label>
        <input type="text" id="p-token" placeholder="search the 1,560 V2 census children… (publish() exists on V2 templates only)" style="min-width:420px" />
        <div id="p-token-list" class="picklist"></div>
      </div>
      <div id="p-facts" class="kv" style="margin:0.6rem 0"></div>
      <div id="p-effects" class="note" style="display:none"></div>
      <div class="x-controls">
        <label class="flabel" style="min-width:auto"><input type="checkbox" id="p-ack" style="vertical-align:middle" /> I understand publishing does not protect this token's custody</label>
      </div>
      <div class="x-controls">
        <button id="p-go" class="pgbtn" disabled>publish()</button>
        <span id="p-note" class="mono xs"></span>
      </div>
      <p class="mono xs" style="color:var(--fg-faint)">
        V3/bureau templates have no publish() — their Debenture clears on the
        registered owner's first withdraw(); V4 has no Debenture at all
        [src] <a href="/knowledge/mechanics/claim-and-publish/">mechanics</a>.
      </p>
    </div>
  </div>

  <div class="panel">
    <h2>log</h2>
    <pre id="txlog" class="mono xs" style="min-height:3rem;white-space:pre-wrap">—</pre>
  </div>

  <p class="provfoot">
    tool: claim / publish — wallet-direct, after mint + walker · encoders
    byte-verified vs web3.py · selectors re-derived from the recovered sources
    [src] · claim semantics verified onchain [chain] (FDIC published-at-birth
    with custody 0 — the publish-≠-protection + farm-spine terminal case) ·
    this tool never routes through MultiHop/Sweeper or any ownable helper
    — standing policy.
  </p>
</Base>

<style>
  label.flabel { color: var(--fg-faint); font-size: 0.8rem; min-width: 5.5rem; display: inline-block; }
  .picklist {
    position: absolute; z-index: 10; background: var(--bg3); border: 1px solid var(--border-bright);
    max-height: 260px; overflow-y: auto; min-width: 420px; display: none;
  }
  .pane { position: relative; }
  button.mode.active { color: var(--accent); border-color: var(--accent); }
</style>
<style is:global>
  .picklist div { padding: 0.2rem 0.5rem; cursor: pointer; font-size: 0.8rem; }
  .picklist div:hover { background: var(--bg2); color: var(--accent); }
  .kv .ok { color: var(--accent); }
  .kv .bad { color: var(--red); }
</style>

<script>
  import {
    SEL, MV_ADDRESS, ethCall, decUint, decBool, decAddr, encCall, parseUnits, formatUnits,
    fmtBig, connectWallet, ensureChain, sendTx, waitTx, getProvider, shortAddr, tokenMeta,
  } from '../lib/web3';

  const V2M = '0xc15c5f699daf5e1135732139f05d2c05b3ef4354';
  const V3M = '0x0c4f73328dfcecfbecf235c9f78a4494a7ec5ddc';
  const V1M = '0xc7bdac3e6bb5ec37041a11328723e9927ccf430b';
  const TBILL = '0x463413c579d29c26d59a65312657dfce30d545a1';

  type Row = { a: string; n: string; s: string; v: string; cls: string; era: string; d: number; mult: number | null; liq: string; p: string | null; blk: number | null };
  let tokens: Row[] = [];
  let byAddr: Map<string, Row> = new Map();

  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const logEl = $('txlog');
  function log(s: string, cls = '') {
    if (logEl.textContent === '—') logEl.textContent = '';
    const line = document.createElement('div');
    if (cls === 'err') line.style.color = 'var(--red)';
    if (cls === 'ok') line.style.color = 'var(--accent)';
    line.textContent = s;
    logEl.appendChild(line);
    logEl.scrollTop = logEl.scrollHeight;
  }
  const link = (text: string, href: string) => `<a href="${href}" target="_blank" rel="noopener">${text}</a>`;

  let wallet: { provider: any; address: string } | null = null;

  async function connect() {
    try {
      const w = await connectWallet();
      await ensureChain(w.provider);
      wallet = w;
      $('w-status').innerHTML = `<span style="color:var(--accent)">connected</span> ${shortAddr(w.address)} · PulseChain`;
      log(`wallet connected: ${w.address}`, 'ok');
      refreshPanes();
    } catch (e: any) {
      log(`wallet: ${e.message ?? e}`, 'err');
    }
  }
  $('w-connect').addEventListener('click', connect);

  function attachPicker(inputId: string, listId: string, onPick: (r: Row | null, addr: string) => void, filter?: (r: Row) => boolean) {
    const input = $(inputId) as HTMLInputElement;
    const list = $(listId);
    let lastPicked = '';
    let debounce: ReturnType<typeof setTimeout> | null = null;
    function rebuild() {
      const q = input.value.trim().toLowerCase();
      const pool = tokens.filter((t) => (filter ? filter(t) : true)).map((t) => ({ label: `${(t.n || '(unnamed)').slice(0, 40)}${(t.n || '').length > 40 ? '…' : ''} (${(t.s || '·').slice(0, 16)}${(t.s || '').length > 16 ? '…' : ''})`, sub: `${t.v} · ${t.cls}`, a: t.a }));
      const items = q
        ? pool.filter((p) => p.label.toLowerCase().includes(q) || p.a.includes(q)).slice(0, 40)
        : [];
      if (!items.length) {
        list.style.display = 'none';
        return;
      }
      list.innerHTML = '';
      for (const it of items) {
        const d = document.createElement('div');
        d.innerHTML = `${it.label} <span style="color:var(--fg-faint)">${it.sub} · ${it.a.slice(0, 10)}…</span>`;
        d.addEventListener('mousedown', (ev) => {
          ev.preventDefault();
          input.value = it.a;
          lastPicked = it.a;
          list.style.display = 'none';
          onPick(byAddr.get(it.a) ?? null, it.a);
        });
        list.appendChild(d);
      }
      list.style.display = 'block';
    }
    input.addEventListener('input', () => {
      rebuild();
      if (debounce) clearTimeout(debounce);
      debounce = setTimeout(() => {
        const v = input.value.trim().toLowerCase();
        if (/^0x[0-9a-f]{40}$/.test(v) && v !== lastPicked) {
          lastPicked = v;
          onPick(byAddr.get(v) ?? null, v);
        }
      }, 400);
    });
    input.addEventListener('focus', rebuild);
    input.addEventListener('blur', () => setTimeout(() => (list.style.display = 'none'), 150));
  }

  function rowOrAddr(v: string): Row {
    const r = byAddr.get(v.trim().toLowerCase());
    if (r) return r;
    return { a: v.trim().toLowerCase(), n: v.trim().toLowerCase(), s: '', v: '', cls: '', era: '', d: 18, mult: null, liq: '', p: null };
  }

  // ---------- claim pane ----------
  type ClaimState = {
    kind: 'v1' | 'v2' | 'v3' | 'v4';
    x: Row;
    parent: string | null;
    parentDec: number;
    parentSym: string;
    custody: bigint | null;
    deb: boolean | null;
    creator: string | null;
  } | null;
  let cl: ClaimState = null;
  let keyAddr: string | null = null;

  type KeyState = {
    k: Row | null;
    addr: string;
    dec: number;
    sym: string;
    eligible: boolean | null;
    verdict: string;
  } | null;
  let ks: KeyState = null;

  attachPicker('cl-token', 'cl-token-list', (r) => { if (r) loadClaimFacts(r); });

  function regOwner(minter: string, ctx: string): Promise<string | null> {
    return ethCall(minter, encCall(SEL.TreasuryTokens, [ctx])).then(decAddr).catch(() => null);
  }

  async function loadClaimFacts(r: Row) {
    cl = null;
    ks = null;
    keyAddr = null;
    ($('cl-key') as HTMLInputElement).value = '';
    $('cl-keyfacts').innerHTML = '';
    $('cl-warn').style.display = 'none';
    $('cl-preview').textContent = '';
    const facts = $('cl-facts');
    facts.innerHTML = '<span class="dim">reading chain…</span>';
    const kind = r.v === 'V1' ? 'v1' : r.v === 'V2' ? 'v2' : r.v === 'V4' ? 'v4' : 'v3';
    try {
      if (kind === 'v1') {
        const tb = decUint(await ethCall(TBILL, encCall(SEL.balanceOf, [r.a])).catch(() => '0x'));
        cl = { kind, x: r, parent: TBILL, parentDec: 18, parentSym: 'TBILL', custody: tb, deb: null, creator: null };
        const cls = r.cls ? `<span class="tag">${r.cls}</span>` : '';
        facts.innerHTML =
          `<dt>payout token</dt><dd>${r.n || '(unnamed)'} (${r.s || '·'}) ${cls} V1 · <a href="/tokens/${r.a}">entity page</a></dd>` +
          `<dt>redemption</dt><dd><span class="bad">none — parity lock</span> (mint pays TBILL 1:1 in; no Claim/publish/withdraw exists)</dd>` +
          `<dt>TBILL locked inside</dt><dd>${formatUnits(tb, 18)} — permanently sunk</dd>`;
        $('cl-key-row').style.display = 'none';
        $('cl-warn').innerHTML = 'V1 children are <b>parity-locked permanent sinks</b> [src]: the TBILL paid at mint is locked with no redemption path — use <a href="/mint?token=' + r.a + '">/mint</a> to add more, nothing ever comes back out.';
        $('cl-warn').style.display = '';
        return;
      }
      let parent: string | null = null;
      try {
        parent = decAddr(await ethCall(r.a, SEL.Parent));
      } catch {}
      if (!parent && r.p) parent = r.p;
      if (!parent) throw new Error('no Parent() readable on this token');
      const [pm, custRaw, debRaw] = await Promise.all([
        tokenMeta(parent),
        ethCall(parent, encCall(SEL.balanceOf, [r.a])).then(decUint).catch(() => null),
        kind === 'v2' || kind === 'v3' ? ethCall(r.a, SEL.Debenture).then(decBool).catch(() => null) : Promise.resolve(null),
      ]);
      const creator = kind === 'v3' ? decAddr(await ethCall(r.a, SEL.Creator).catch(() => '0x')) : null;
      cl = { kind, x: r, parent, parentDec: pm.decimals, parentSym: pm.symbol || shortAddr(parent), custody: custRaw, deb: debRaw, creator };
      const cls = r.cls ? `<span class="tag">${r.cls}</span>` : '';
      const liq = r.liq ? ` · liquidity: ${r.liq}` : '';
      facts.innerHTML =
        `<dt>payout token</dt><dd>${r.n || '(unnamed)'} (${r.s || '·'}) ${cls} ${r.v} ${liq} · <a href="/tokens/${r.a}">entity page</a></dd>` +
        `<dt>parent collateral</dt><dd>${cl.parentSym} <span class="mono xs">${parent}</span> (${pm.decimals} dec)</dd>` +
        `<dt>locked custody</dt><dd>${custRaw === null ? '—' : `${formatUnits(custRaw, pm.decimals)} ${cl.parentSym} held inside the token`}</dd>` +
        (kind === 'v2' || kind === 'v3' ? `<dt>Debenture</dt><dd>${debRaw === null ? '—' : debRaw ? 'true' : 'false'}</dd>` : '') +
        (kind === 'v3' ? `<dt>Creator</dt><dd>${creator ?? '—'}</dd>` : '');
      const warn: string[] = [];
      $('cl-key-row').style.display = kind === 'v4' ? 'none' : '';
      if (parent === TBILL && kind !== 'v2') warn.push(`parent is TBILL: Claim reverts on this token (TreasuryBillContract guard) — a permanent sink.`);
        if (custRaw === 0n) warn.push(`<b>parent custody is 0</b> — claims on this token revert (0%-backing, farm-spine terminal state; e.g. FDIC itself). See <a href="/knowledge/mechanics/claim-and-publish/">mechanics</a>.`);
      if (kind === 'v2') {
        if (debRaw === true) warn.push('unpublished V2 child: this token is itself a <b>live claim key</b> against its siblings — anyone holding it can claim them.');
        if (debRaw === false) warn.push('published V2 child: publishing removed its <b>key</b> role only — claims <b>on</b> it continue until custody is drained (<b>publish ≠ protection</b>).');
      }
      if (kind === 'v3' && debRaw === false) warn.push('Debenture = false: the payout side is dead (registered owner already withdrew once). Claims revert.');
      if (kind === 'v4') warn.push('V4 = <b>self-redeem</b>: burn your own tokens, parent pays 1:1 — no key needed.');
      if (warn.length) {
        $('cl-warn').innerHTML = warn.join('<br>');
        $('cl-warn').style.display = '';
      } else {
        $('cl-warn').style.display = 'none';
      }
      previewClaim();
    } catch (e: any) {
      facts.innerHTML = `<dd class="bad">${e.message ?? e}</dd>`;
    }
  }

  attachPicker('cl-key', 'cl-key-list', (r, addr) => { keyAddr = addr; loadKeyFacts(r, addr); });
  ($('cl-amount') as HTMLInputElement).addEventListener('input', () => previewClaim());

  async function loadKeyFacts(r: Row | null, addr: string) {
    ks = null;
    const kf = $('cl-keyfacts');
    if (!cl || cl.kind === 'v4' || cl.kind === 'v1') return;
    const c = cl;
    kf.innerHTML = '<span class="dim">checking key eligibility…</span>';
    try {
      const [km, balRaw] = await Promise.all([
        tokenMeta(addr),
        wallet ? ethCall(addr, encCall(SEL.balanceOf, [wallet.address])).then(decUint).catch(() => null) : Promise.resolve(null),
      ]);
      let verdict = '';
      let eligible: boolean | null = null;
      if (c.kind === 'v2') {
        const [v2owner, v1owner] = await Promise.all([regOwner(V2M, addr), regOwner(V1M, addr)]);
        if (v2owner) {
          const kdeB = decBool(await ethCall(addr, SEL.Debenture).catch(() => '0x'));
          eligible = kdeB;
          verdict = kdeB
            ? `<span class="ok">eligible</span> — V2-registered sibling, Debenture = true (unpublished key)`
            : `<span class="bad">not a key</span> — V2-registered but published (Debenture = false)`;
        } else if (v1owner) {
          eligible = true;
          verdict = `<span class="ok">eligible</span> — V1-registry token (fallback path [src]: no Debenture check applies)`;
        } else {
          eligible = false;
          verdict = `<span class="bad">unregistered</span> — in neither the V1 nor V2 registry; Claim reverts (FuckOff)`;
        }
      } else {
        const [v3owner, kCreatorRaw, kParentRaw] = await Promise.all([
          regOwner(V3M, addr),
          ethCall(addr, SEL.Creator).catch(() => '0x'),
          ethCall(addr, SEL.Parent).catch(() => '0x'),
        ]);
        const kCreator = decAddr(kCreatorRaw);
        const kParent = decAddr(kParentRaw);
        const c1 = !!v3owner;
        const c2 = !!kCreator && !!c.creator && kCreator === c.creator;
        const c3 = !!kParent && !!c.parent && kParent === c.parent;
        eligible = c1 && c2 && c3;
        verdict =
          `<span class="${eligible ? 'ok' : 'bad'}">${eligible ? 'eligible' : 'not a key'}</span> — V3-registry: ${c1 ? '✓' : '✗'} · same Creator: ${c2 ? '✓' : '✗'} · same Parent: ${c3 ? '✓' : '✗'} (all three required [src])`;
      }
      ks = { k: r, addr, dec: km.decimals, sym: (km.symbol || '').slice(0, 16) || shortAddr(addr), eligible, verdict };
      kf.innerHTML =
        `<dt>key</dt><dd>${(km.name || shortAddr(addr)).slice(0, 40)} (${(km.symbol || '·').slice(0, 16)}) <span class="mono xs">${addr}</span></dd>` +
        `<dt>eligibility</dt><dd>${verdict}</dd>` +
        (balRaw !== null ? `<dt>your key balance</dt><dd>${formatUnits(balRaw, km.decimals)} ${(km.symbol || '').slice(0, 16)}</dd>` : '');
      previewClaim();
    } catch (e: any) {
      kf.innerHTML = `<dd class="bad">${e.message ?? e}</dd>`;
    }
  }

  function previewClaim() {
    const pv = $('cl-preview');
    if (!cl) { pv.textContent = ''; return; }
    const dec = cl.kind === 'v4' ? (cl.x.d ?? 18) : (ks?.dec ?? 18);
    let amount: bigint;
    try {
      amount = parseUnits(($('cl-amount') as HTMLInputElement).value || '0', dec);
    } catch {
      pv.innerHTML = '<span style="color:var(--red)">bad amount</span>';
      return;
    }
    if (amount <= 0n) { pv.textContent = ''; return; }
    if (cl.kind === 'v2' || cl.kind === 'v3') {
      if (!ks) { pv.textContent = ''; return; }
      const unit = ks.sym;
      const remain = cl.custody !== null && amount <= cl.custody ? ` · ${formatUnits(cl.custody - amount, cl.parentDec)} ${cl.parentSym} remains locked` : '';
      const over = cl.custody !== null && amount > cl.custody ? ` · <span style="color:var(--red)">exceeds custody ${formatUnits(cl.custody, cl.parentDec)} — Claim will revert</span>` : '';
      pv.innerHTML = `surrender <b>${formatUnits(amount, ks.dec)} ${unit}</b> → receive <b>${formatUnits(amount, cl.parentDec)} ${cl.parentSym}</b> 1:1 (raw)${remain}${over}`;
    } else {
      const over = cl.custody !== null && amount > cl.custody ? ` · <span style="color:var(--red)">exceeds custody ${formatUnits(cl.custody, cl.parentDec)} — Claim will revert</span>` : '';
      pv.innerHTML = `burn <b>${formatUnits(amount, dec)}</b> → receive <b>${formatUnits(amount, cl.parentDec)} ${cl.parentSym}</b> 1:1${over}`;
    }
  }

  async function doClaim() {
    if (!wallet) return log('connect a wallet first', 'err');
    if (!cl || cl.kind === 'v1') return log('pick a claimable token first', 'err');
    try {
      if (cl.kind === 'v4') {
        const amount = parseUnits(($('cl-amount') as HTMLInputElement).value || '0', cl.x.d ?? 18);
        if (amount <= 0n) return log('amount must be positive', 'err');
        await runClaim(cl.x.a, amount, cl.x.a, true);
      } else {
        if (!ks || !keyAddr) return log('pick a claim key first', 'err');
        if (ks.eligible === false) return log('this key is not eligible — see the eligibility panel', 'err');
        const amount = parseUnits(($('cl-amount') as HTMLInputElement).value || '0', ks.dec);
        if (amount <= 0n) return log('amount must be positive', 'err');
        await runClaim(cl.x.a, amount, keyAddr, false);
      }
    } catch (e: any) {
      log(`claim failed: ${e.message ?? e}`, 'err');
    }
  }

  async function runClaim(x: string, amount: bigint, key: string, self: boolean) {
    const al = decUint(await ethCall(key, encCall(SEL.allowance, [wallet!.address, x])));
    if (al < amount) {
      log(`approving ${self ? 'the token to take your units (self-redeem transferFrom)' : 'key to the payout token'}…`);
      const ah = await sendTx(wallet!.provider, wallet!.address, key, encCall(SEL.approve, [x, amount]));
      log(`approve tx ${link(ah, `https://ipfs.scan.pulsechain.com/tx/${ah}`)} — waiting…`);
      const ar = await waitTx(wallet!.provider, ah);
      if (ar.status !== '0x1') return log('approve reverted — aborting', 'err');
      log('approve confirmed', 'ok');
    }
    const data = self ? encCall(SEL.Claim1, [amount]) : encCall(SEL.Claim2, [key, amount]);
    log(`sending Claim(${self ? formatUnits(amount, 18) : shortAddr(key) + ', ' + formatUnits(amount, ks?.dec ?? 18)}) → Recovery(you, key, amount), parent pays 1:1…`);
    const th = await sendTx(wallet!.provider, wallet!.address, x, data);
    log(`claim tx ${link(th, `https://ipfs.scan.pulsechain.com/tx/${th}`)} — waiting…`);
    const r = await waitTx(wallet!.provider, th);
    if (r.status === '0x1') log('claim confirmed ✓ — custody updated; reload the token facts to see the new ceiling', 'ok');
    else log('Claim() reverted — common causes: key eligibility changed, key balance/allowance, custody drained below amount', 'err');
  }
  $('cl-go').addEventListener('click', doClaim);

  // ---------- publish pane ----------
  type PubState = {
    x: Row;
    owner: string | null;
    hu: number | null;
    deb: boolean | null;
    parent: string | null;
    custody: bigint | null;
    parentSym: string;
    parentDec: number;
  } | null;
  let ps: PubState = null;

  attachPicker('p-token', 'p-token-list', (r) => { if (r) loadPubFacts(r); }, (r) => r.v === 'V2');
  $('p-ack').addEventListener('change', () => ($('p-go') as HTMLButtonElement).disabled = !ps || !($('p-ack') as HTMLInputElement).checked || ps.deb !== true);

  async function loadPubFacts(r: Row) {
    ps = null;
    ($('p-ack') as HTMLInputElement).checked = false;
    ($('p-go') as HTMLButtonElement).disabled = true;
    $('p-note').textContent = '';
    const facts = $('p-facts');
    facts.innerHTML = '<span class="dim">reading chain…</span>';
    $('p-effects').style.display = 'none';
    try {
      const [owner, debRaw, parentRaw] = await Promise.all([
        regOwner(V2M, r.a),
        ethCall(r.a, SEL.Debenture).then(decBool).catch(() => null),
        ethCall(r.a, SEL.Parent).then(decAddr).catch(() => null),
      ]);
      const hu = wallet ? Number(decUint(await ethCall(r.a, encCall(SEL._hu, [wallet.address])).catch(() => '0x'))) : null;
      let custody: bigint | null = null;
      let pm = { decimals: 18, symbol: '' };
      if (parentRaw) {
        [custody, pm] = await Promise.all([
          ethCall(parentRaw, encCall(SEL.balanceOf, [r.a])).then(decUint).catch(() => null),
          tokenMeta(parentRaw),
        ]);
      }
      ps = { x: r, owner, hu, deb: debRaw, parent: parentRaw, custody, parentSym: pm.symbol || (parentRaw ? shortAddr(parentRaw) : '—'), parentDec: pm.decimals };
      const ownerIsYou = wallet && owner && owner.toLowerCase() === wallet.address.toLowerCase();
      facts.innerHTML =
        `<dt>token</dt><dd>${r.n || '(unnamed)'} (${r.s || '·'}) <span class="tag">${r.cls}</span> V2 · <a href="/tokens/${r.a}">entity page</a></dd>` +
        `<dt>registered owner</dt><dd>${owner ?? '—'}${ownerIsYou ? ' <span class="ok">(you — withdraw() unlocks on publish)</span>' : ''}</dd>` +
        `<dt>_hu[your wallet]</dt><dd>${hu === null ? '— (connect wallet)' : hu + ' (publish needs ≥ 100; the creator EOA holds 255)'}</dd>` +
        `<dt>Debenture</dt><dd>${debRaw === null ? '—' : debRaw ? 'true (unpublished)' : 'false — already published, publish() would be a no-op flag-set'}</dd>` +
        `<dt>locked custody</dt><dd>${custody === null ? '—' : `${formatUnits(custody, ps.parentDec)} ${ps.parentSym} — stays fully claimable by others after you publish`}</dd>`;
      const effects =
        `<b>what publish() does</b> [src]:<br>` +
        `· sets Debenture = false <b>permanently</b> — no code path ever sets it back<br>` +
        `· this token stops being a <b>claim key</b> against its V2 siblings (it can never be surrendered as a key again)<br>` +
        `· unlocks <span class="mono xs">withdraw(token, value)</span> for the registered owner — recovery of stuck non-parent tokens only<br>` +
        `· emits <span class="mono xs">Published(this)</span><br>` +
        `<b>what publish() does NOT do</b> [src]/[chain]:<br>` +
        `· it does <b>not</b> stop claims <b>on</b> this token — every eligible sibling key can still drain the parent custody above (publish ≠ protection; the published bureau-ancestry spine FDIC → DFM → PARADE → Tellerz was claim-farmed ~20 months and is still active)<br>` +
        `· it does not move, lock or protect any funds, and does not affect mint()<br>` +
        `gate: _hu[tx.origin] ≥ 100 — ${hu === null ? 'connect wallet to check' : hu >= 100 ? '<span class="ok">your wallet passes</span>' : '<span class="bad">your wallet fails</span>'}`;
      $('p-effects').innerHTML = effects;
      $('p-effects').style.display = '';
    } catch (e: any) {
      facts.innerHTML = `<dd class="bad">${e.message ?? e}</dd>`;
    }
  }

  async function doPublish() {
    if (!wallet) return log('connect a wallet first', 'err');
    if (!ps) return log('pick a V2 token first', 'err');
    if (!( $('p-ack') as HTMLInputElement).checked) return log('acknowledge the effect preview first', 'err');
    try {
      log(`sending ${shortAddr(ps.x.a)}.publish() — Debenture → false, permanent…`);
      const th = await sendTx(wallet.provider, wallet.address, ps.x.a, encCall(SEL.publish, []));
      log(`publish tx ${link(th, `https://ipfs.scan.pulsechain.com/tx/${th}`)} — waiting…`);
      const r = await waitTx(wallet.provider, th);
      if (r.status === '0x1') log('publish confirmed ✓ — the token is no longer a claim key; custody remains claimable by others', 'ok');
      else log('publish() reverted — gate: _hu[tx.origin] must be ≥ 100 (the creator EOA holds 255)', 'err');
    } catch (e: any) {
      log(`publish failed: ${e.message ?? e}`, 'err');
    }
  }
  $('p-go').addEventListener('click', doPublish);

  // ---------- mode / deeplink / boot ----------
  function setMode(mode: 'claim' | 'publish') {
    $('pane-claim').style.display = mode === 'claim' ? '' : 'none';
    $('pane-publish').style.display = mode === 'publish' ? '' : 'none';
    ($('mode-claim') as HTMLButtonElement).classList.toggle('active', mode === 'claim');
    ($('mode-publish') as HTMLButtonElement).classList.toggle('active', mode === 'publish');
  }
  $('mode-claim').addEventListener('click', () => setMode('claim'));
  $('mode-publish').addEventListener('click', () => setMode('publish'));

  function refreshPanes() {
    if (cl) loadClaimFacts(cl.x);
    if (ps) loadPubFacts(ps.x);
  }

  fetch('/data/tokens_v2.compact.json')
    .then((r) => r.json())
    .then((d) => {
      tokens = d.tokens;
      byAddr = new Map(tokens.map((t: Row) => [t.a, t]));
      const q = new URLSearchParams(location.search);
      const tok = q.get('token');
      if (tok && byAddr.has(tok.toLowerCase())) {
        ($('cl-token') as HTMLInputElement).value = tok.toLowerCase();
        loadClaimFacts(byAddr.get(tok.toLowerCase())!);
      }
    })
    .catch((e) => log('failed to load census bundle: ' + e, 'err'));

  if (getProvider()) {
    getProvider()!.request({ method: 'eth_accounts' }).then((accs: string[]) => {
      if (accs?.length) connect();
    }).catch(() => {});
  }
</script>
