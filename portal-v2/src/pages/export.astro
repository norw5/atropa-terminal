---
import Base from '../layouts/Base.astro';
import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';

const repoRoot = resolve(process.cwd(), '..');
const readJson = (rel: string) => JSON.parse(readFileSync(resolve(repoRoot, rel), 'utf8'));
const manifest = existsSync(resolve(repoRoot, 'portal-v2/public/exports/atropa-kb-v2.manifest.json'))
  ? readJson('portal-v2/public/exports/atropa-kb-v2.manifest.json') : null;
const artIdx = existsSync(resolve(repoRoot, 'portal-v2/public/artifacts/index.json'))
  ? readJson('portal-v2/public/artifacts/index.json') : null;
const nBc = artIdx ? Object.keys(artIdx.bytecode ?? {}).length : 0;
const nSrc = artIdx ? Object.keys(artIdx.sources ?? {}).length : 0;
const nVer = artIdx ? Object.keys(artIdx.verified_by_address ?? {}).length : 0;
const nDec = artIdx ? Object.keys(artIdx.decompiled_by_address ?? {}).length : 0;

const bundles = [
  ['/data/tokens_v2.compact.json', 'census explorer bundle', 'all 3,129 minter children: identity, taxonomy class/era/origin, lineage parent, liquidity reality, supply, multiplier'],
  ['/data/registry.compact.json', 'contract registry bundle', '356 classified contracts with deploy facts, admin surface, verification state, liquidity'],
  ['/data/claims.compact.json', 'claim registry', '105 machine-checkable claim-classes + by-entity index'],
  ['/data/taxonomy.compact.json', 'taxonomy fields', 'per-token tax_* fields over the census'],
  ['/data/timeline.compact.json', 'master chronology', 'era boundaries, known-actor deployments, TBILL ledger, crisis sequence, supply cliffs'],
  ['/data/irc.compact.json', 'IRC corpus (parsed)', '103,550 parsed lines with line numbers, timestamps, users (raw log below)'],
  ['/data/atropa_logged.txt', 'IRC raw log (verbatim)', 'the complete owner-provided #atropa_logged file, byte-faithful'],
  ['/data/graph_atropa_subgraph.json', 'liquidity subgraph', '1,981 nodes / 15,285 links, WPLS-anchored — never the full DEX graph'],
  ['/data/pools.compact.json', 'per-token pool aggregates', '1,830 tokens: live/total pairs, WPLS anchored, factories, top counterparties, anchor pair'],
  ['/data/shared_infra.compact.json', 'shared infra state', 'math family owner/supply probe (cross-portal bundle)'],
  ['/data/tokens.csv', 'census CSV', 'full-field census export (census + extensions + taxonomy)'],
  ['/abi/tt-templates.json', 'TT template ABIs', 'embedded child-template ABIs per era [src]'],
  ['/artifacts/index.json', 'artifact index', 'address → bytecode/source/verified/decompiled map for the per-entity downloads below'],
];
const artifactsRows = [
  ['/artifacts/bytecode/', 'per-contract bytecode', `${nBc} runtime-bytecode JSONs (hex + sha256; creation input for the 8 factories) — the bytecode-archaeology set plus every registry contract outside it [chain]`],
  ['/artifacts/src/', 'source files', `${nSrc} recovered + blockscout-verified sources incl. the V1 decompilation [src] — same exclusion set as the tarball (no dysnomia/wallet)`],
  ['/artifacts/verified/', 'verified source + ABI', `${nVer} blockscout-verified contracts as published (source files + ABI + compiler facts) [ext-api]`],
  ['/artifacts/decompiled/', 'curated decompilations', `${nDec} heimdall-rs decompilations of notable UNVERIFIED contracts (math family, cDc, helpers) — non-normative research aids [src-decompiled]`],
  ['/abi/', 'interaction ABIs', 'per-minter head + child-template + ERC-20 ABI artifacts [src]'],
];
---

<Base title="export" active="export">
  <h1><span style="color:var(--fg-faint)">dd</span> /export — data surfaces</h1>
  <p style="color:var(--fg-dim);max-width:64rem">
    Every export is a <b>view of the data layer</b>, generated by the same
    pipeline that renders this site — never a new source of truth. Compact
    bundles are the exact files this portal's islands fetch; the CSV and
    tarball are build-time artifacts. Regeneration is a fixed, ordered
    pipeline (taxonomy → claims → bundles → corpus/chronology generators →
    ABIs → artifacts → tarball) documented under&nbsp;
    <a href="/knowledge/method/provenance/">method</a>.
  </p>

  <div class="panel">
    <h2>bundles &amp; artifacts</h2>
    <table class="sortable">
      <thead><tr><th>artifact</th><th>what</th><th>contents</th></tr></thead>
      <tbody>
        {bundles.map(([href, what, contents]) => (
          <tr>
            <td class="wrapok"><a href={href} download>{href.replace('/data/', '').replace('/abi/', 'abi/')}</a></td>
            <td class="wrapok">{what}</td>
            <td class="wrapok dim">{contents}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="panel">
    <h2>docs + sources tarball</h2>
    <p>
      <a href="/exports/atropa-kb-v2.tar.gz" download>atropa-kb-v2.tar.gz</a>
      {manifest && <> — {manifest.contents.map((c: any) => `${c.files} files in ${c.path}`).join(' + ')}
      · sha256 <span class="mono xs">{manifest.tarball_sha256}</span></>}
    </p>
    <p class="dim">
      The public KB content tree (normative mechanics, method, taxonomy) plus
      every recovered and blockscout-verified Solidity source
      (<span class="mono xs">docs/solidity/</span> top level + verified/;
      the out-of-scope dysnomia/wallet trees are excluded). A&nbsp;
      <span class="mono xs">MANIFEST.json</span> is inside.
      Per-minter ABI artifacts also live at&nbsp;
      <span class="mono xs">/abi/{'{address}'}.json</span> for the 8 factories.
    </p>
  </div>

  <div class="panel">
    <h2>per-entity artifacts <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(downloads)</span></h2>
    <table class="sortable">
      <thead><tr><th>artifact</th><th>what</th><th>contents</th></tr></thead>
      <tbody>
        {artifactsRows.map(([href, what, contents]) => (
          <tr>
            <td class="wrapok mono xs">{href}</td>
            <td class="wrapok">{what}</td>
            <td class="wrapok dim">{contents}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="dim">
      Linked from every entity page that has one (bytecode + verified source
      + decompilation where held; sources + ABIs on the core set) — downloaded
      on click, never inlined into pages. Generated by the artifact pipeline
      behind the <a href="/export">artifact index</a>.
    </p>
  </div>

  <div class="panel">
    <h2>filtered CSV</h2>
    <p>
      The <a href="/tokens">/tokens</a> explorer island can export its&nbsp;
      <i>currently filtered</i> rows as CSV (client-side, same compact bundle
      — no server involved). Apply filters there, then press&nbsp;
      <span class="mono xs">export CSV</span> at the bottom of the table.
    </p>
  </div>

  <p class="provfoot">
    exports are views of the data layer · license/provenance
    per <a href="/knowledge/method/provenance/">method</a>: [src]/[chain] tags apply
    to every field.
  </p>
</Base>
