---
import Base from '../../layouts/Base.astro';
import { loadTokensBundle } from '../../lib/data';

const bundle = loadTokensBundle();
const kinds = bundle._meta?.kinds ?? {};
const total = bundle.tokens.length;
const KIND_ORDER: [string, string][] = [
  ['tt', 'treasury children'], ['old-era', 'old-era'], ['standalone', 'standalone'],
  ['reserve', 'reserves'], ['payment', 'payment'], ['shared-infra', 'shared infra'],
  ['affection', 'AFFECTION'], ['forked', 'fork-carried'], ['bridge', 'bridge-wrapped'],
];
---

<Base title="tokens" active="tokens">
  <div class="col">
    <h1><span style="color:var(--fg-faint)">ls</span> /tokens — every ERC-20 in the corpus, unified</h1>
    <p style="color:var(--fg-dim);max-width:60rem">
      All {total.toLocaleString()} classified ERC-20s in one table —
      completeness by construction, no editorial selection: the
      {((kinds['tt'] ?? 0)).toLocaleString()} factory children (V1–V4 + Bureau#1,
      mechanically-defined census) plus {((total - (kinds['tt'] ?? 0))).toLocaleString()}
      registry tokens — old-era corpus, standalones, reserves, payment asset,
      shared infrastructure, AFFECTION, fork-carried and bridge-wrapped sets.
      Kind mix: {KIND_ORDER.filter(([k]) => kinds[k]).map(([k, l]) => `${l} ${(kinds[k]).toLocaleString()}`).join(' · ')}.
      Treasury rows link to their token entity pages, registry rows to their
      contract entity pages (the two page families carry different field sets).
    </p>
  </div>

  <div class="panel wide">
    <h2>explorer <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(client island — fetches /data/tokens_unified.compact.json; 200 rows/page)</span></h2>
    <div class="x-controls">
      <input type="text" id="x-q" placeholder="grep name / symbol / address…" />
      <select id="x-k">
        <option value="">kind: all</option>
        <option value="tt">treasury children</option>
        <option value="old-era">old-era</option>
        <option value="standalone">standalone</option>
        <option value="reserve">reserve</option>
        <option value="payment">payment</option>
        <option value="shared-infra">shared infra</option>
        <option value="affection">affection</option>
        <option value="forked">fork-carried</option>
        <option value="bridge">bridge-wrapped</option>
      </select>
      <select id="x-v">
        <option value="">factory: all</option>
        <option value="V1">V1</option>
        <option value="V2">V2</option>
        <option value="V3">V3</option>
        <option value="V4">V4</option>
        <option value="BureauMinter#1">BUREAU</option>
      </select>
      <select id="x-cls">
        <option value="">class: all</option>
        <option value="v1-parity-lock-tt">v1-parity-lock-tt</option>
        <option value="v2-debenture-tt">v2-debenture-tt</option>
        <option value="v3-step-tt">v3-step-tt</option>
        <option value="v4-self-scaled-tt">v4-self-scaled-tt</option>
        <option value="bureau-tt">bureau-tt</option>
        <option value="old-era-ownable">old-era-ownable</option>
        <option value="old-era-other">old-era-other</option>
        <option value="standalone-pre-v1">standalone-pre-v1</option>
        <option value="standalone-post-v4">standalone-post-v4</option>
        <option value="reserve-asset">reserve-asset</option>
        <option value="payment-asset">payment-asset</option>
        <option value="shared-infrastructure">shared-infrastructure</option>
        <option value="affection-family">affection-family</option>
        <option value="forked-asset">forked-asset</option>
        <option value="bridge-asset">bridge-asset</option>
      </select>
      <select id="x-era">
        <option value="">era: all</option>
        <option value="pre-fork">pre-fork</option>
        <option value="old-atropa">old-atropa</option>
        <option value="pre-v1">pre-v1</option>
        <option value="v1">v1</option>
        <option value="v2">v2</option>
        <option value="v3-bureau">v3-bureau</option>
        <option value="v4">v4</option>
        <option value="post-crisis">post-crisis</option>
        <option value="long-tail">long-tail</option>
        <option value="treasury-window">treasury-window</option>
      </select>
      <select id="x-org">
        <option value="">origin: all</option>
        <option value="core">core</option>
        <option value="core-factory">core-factory</option>
        <option value="external">external</option>
      </select>
      <select id="x-liq">
        <option value="">liquidity: any</option>
        <option value="pooled-live">pooled-live</option>
        <option value="pooled-dead-all">pooled-dead-all</option>
        <option value="spine-only-paper">spine-only-paper</option>
        <option value="burnt-locked-50">flag: burnt-locked-50</option>
      </select>
      <span class="x-count" id="x-count"></span>
    </div>
    <div style="overflow-x:auto">
      <table class="x-table" id="x-table">
        <thead>
          <tr>
            <th class="sort-th" data-col="n">name</th>
            <th class="sort-th" data-col="s">sym</th>
            <th class="sort-th" data-col="k">kind/ver</th>
            <th class="sort-th" data-col="cls">class/era</th>
            <th class="sort-th num" data-col="sup">supply</th>
            <th class="sort-th num" data-col="mult">mult</th>
            <th class="sort-th" data-col="liq">liquidity</th>
            <th class="sort-th" data-col="org">origin</th>
            <th class="sort-th" data-col="ts">created</th>
            <th class="sort-th" data-col="flags">flags</th>
            <th data-col-x="act" title="one-click deep links into the tools (treasury children)">act</th>
          </tr>
        </thead>
        <tbody id="x-body"></tbody>
      </table>
    </div>
    <div class="x-controls">
      <button id="x-prev" class="pgbtn">← prev</button>
      <span class="x-count" id="x-page"></span>
      <button id="x-next" class="pgbtn">next →</button>
      <button id="x-csv" class="pgbtn">export CSV (filtered rows)</button>
    </div>
  </div>

  <div class="col">
    <div class="panel">
      <h2>field &amp; class legend <span style="color:var(--fg-faint);font-weight:400;font-size:0.8rem">(the explorer table, explained — also on the column headers)</span></h2>
    <dl class="kv">
      <dt>name / sym</dt><dd>treasury children: onchain ERC-20 <span class="mono xs">name()</span> / <span class="mono xs">symbol()</span> (offset-aware re-probe) — registry tokens: curated registry label + onchain symbol. Treasury rows link to the token entity page, registry rows to the contract entity page</dd>
      <dt>kind/ver</dt><dd>treasury children: factory generation (V1–V4, BR = Bureau#1) — the minter that created the child; registry tokens: corpus kind (old-era, standalone, reserve, payment, shared infra, affection, fork-carried, bridge-wrapped)</dd>
      <dt>class/era</dt><dd>taxonomy class (derived from mechanics, not community names) + era band; definitions on <a href="/knowledge/taxonomy/classes/">/knowledge/taxonomy/classes</a></dd>
      <dt>supply</dt><dd>totalSupply at the custody snapshot block (human units) — treasury children only (registry tokens are not supply-snapshotted); not comparable across tokens as a ranking (arbitrary decimals and initial mints)</dd>
      <dt>mult</dt><dd>live <span class="mono xs">Multiplier()</span> cost factor for <span class="mono xs">mint()</span> at the snapshot — see <a href="/knowledge/mechanics/multipliers/">multipliers</a></dd>
      <dt>liquidity</dt><dd><span class="tag">pooled-live</span> at least one pool with live reserves · <span class="tag">pooled-dead-all</span> all pools dead/empty · <span class="tag">spine-only-paper</span> no pool ever · <span class="badge">burnt-locked-50</span> flag = ≥50% of LP burnt — structure on <a href="/knowledge/reference/liquidity/">/knowledge/reference/liquidity</a></dd>
      <dt>origin</dt><dd><span class="badge">core</span> Maria-authored standalone · <span class="badge">core-factory</span> factory child (core by construction) · <span class="badge">external</span> fork-carried / bridge-wrapped / outside the ecosystem's deployer keys</dd>
      <dt>created</dt><dd>creation-block timestamp (UTC date)</dd>
      <dt>flags</dt><dd><span class="badge canon">CANON</span> = on the dev-published t-share list (alias only) + liquidity flags</dd>
      <dt>act</dt><dd>deep links into the interaction tools — <a href="/mint">mint</a> (mint-existing with live multiplier preview) · <a href="/claim">claim</a> (eligibility verdict, self-redeem, publish tab); treasury children only</dd>
      <dt>kinds</dt>
      <dd>
        <span class="tag">treasury</span> factory child (the census) ·
        <span class="tag">old-era</span> Maria #2's 2023–24 corpus ·
        <span class="tag">standalone</span> Maria #1 direct deploy outside the factory era ·
        <span class="tag">reserve</span> FED / TBILL ·
        <span class="tag">payment</span> MV — the universal minter payment ·
        <span class="tag">shared-infra</span> the math family ·
        <span class="tag">affection</span> AFFECTION Ⓐ ·
        <span class="tag">forked</span> Ethereum-genesis fork-carried ·
        <span class="tag">bridge</span> official-bridge e-tokens
      </dd>
    </dl>
    <p class="dim" style="font-size:0.85rem">
      No JavaScript? The full unified token corpus is downloadable as CSV:&nbsp;
      <a href="/data/tokens_all.csv" download>tokens_all.csv</a> (minter-children
      census only: <a href="/data/tokens.csv" download>tokens.csv</a>) — plus every
      bundle on <a href="/export">/export</a>. Default order = creation date,
      oldest first; click any column header to sort (asc → desc → default).
    </p>
    </div>
  </div>
</Base>

<style is:global>
  main { max-width: none; }
  main > .col { max-width: calc(1200px - 2.8rem); margin-left: auto; margin-right: auto; }
  main > .panel.wide {
    width: fit-content;
    min-width: min(calc(1200px - 2.8rem), 100%);
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }
  #x-table td.clamped.name { overflow-wrap: anywhere; min-width: 20ch; }
  #x-table td.actcell { white-space: nowrap; }
  #x-table td.actcell a { color: var(--accent); }
  #x-table td.actcell a:hover { text-decoration: underline; }
</style>

<script>
  type Row = {
    a: string; n: string; s: string; k: string; v: string | null; cls: string; era: string;
    org: string; liq: string; lf: string[]; blk: number; ts: number; d: number | null;
    sup: number | null; mult: number | null; canon: boolean;
  };

  const PAGE = 200;
  let rows: Row[] = [];
  let view: Row[] = [];
  let page = 0;
  let sortCol: string | null = 'ts';
  let sortDir: 1 | -1 = 1;

  const fmt = (v: number | null, d = 1): string => {
    if (v === null || v === undefined || Number.isNaN(v)) return '—';
    const a = Math.abs(v);
    if (a >= 1e12) return (v / 1e12).toFixed(d) + 'T';
    if (a >= 1e9) return (v / 1e9).toFixed(d) + 'B';
    if (a >= 1e6) return (v / 1e6).toFixed(d) + 'M';
    if (a >= 1e3) return (v / 1e3).toFixed(d) + 'k';
    return String(Math.round(v * 100) / 100);
  };
  const bdate = (t: number | null) => (t ? new Date(t * 1000).toISOString().slice(0, 10) : '—');

  function esc(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  }
  const clip = (s: string | null | undefined, n: number): string => {
    const v = (s || '').trim();
    return v.length > n ? v.slice(0, n) + '…' : v;
  };
  const tip = (s: string | null | undefined): string => {
    const v = (s || '').trim();
    return v.length > 200 ? `${v.length.toLocaleString()} characters — full text on the token page` : v;
  };

  const body = document.getElementById('x-body') as HTMLTableSectionElement;
  const countEl = document.getElementById('x-count') as HTMLElement;
  const pageEl = document.getElementById('x-page') as HTMLElement;

  const K_TIP: Record<string, string> = {
    tt: 'treasury child — factory-created (the census)',
    'old-era': "Maria #2's 2023–24 direct-deploy corpus",
    standalone: "Maria #1 direct deployment outside the factory era",
    reserve: 'reserve asset (FED / TBILL)',
    payment: 'payment asset — MV, the universal New() fee',
    'shared-infra': 'shared infrastructure — the math family',
    affection: 'AFFECTION Ⓐ (mechanics canonical in the AFFECTION portal)',
    forked: 'Ethereum-genesis CA, fork-carried at PulseChain genesis (de-pegged)',
    bridge: 'official-bridge wrapped e-token',
  };
  const VER_TIP: Record<string, string> = {
    V1: 'created by the V1 TbillMinter factory',
    V2: 'created by the V2 FederalMinter factory',
    V3: 'created by the V3 IndexMinter factory',
    V4: 'created by the V4 PersonalMinter factory',
    'BureauMinter#1': 'created by the BureauMinter#1 factory (V3 rules, fixed BUREAU parent)',
  };
  const CLS_TIP: Record<string, string> = {
    'v1-parity-lock-tt': 'V1 child — TBILL-parity lock, no exit',
    'v2-debenture-tt': 'V2 child — Debenture/claim-key model',
    'v3-step-tt': 'V3 child — step multiplier',
    'v4-self-scaled-tt': 'V4 child — self-scaled minting',
    'bureau-tt': 'BureauMinter#1 child',
    'old-era-ownable': "Maria #2's 2023–24 corpus — Ownable template",
    'old-era-other': "2023–24 corpus — other templates (incl. the trebizond set)",
    'standalone-pre-v1': 'Maria #1 direct deploy, pre-V1 window (Keys Of Ong, ㈞, …)',
    'standalone-post-v4': 'Maria #1 direct deploy, post-V4 window (Basilica, IYC, …)',
    'reserve-asset': 'reserve asset backing the treasury system',
    'payment-asset': 'the universal minter payment asset',
    'shared-infrastructure': 'math family — the shared RNG orbit',
    'affection-family': 'the AFFECTION token (separate portal carries the mechanics)',
    'forked-asset': 'Ethereum-genesis CA, fork-carried (de-pegged, Ethereum-era admin state)',
    'bridge-asset': 'official-bridge wrapped e-token (holds peg)',
  };
  const ERA_TIP: Record<string, string> = {
    v1: 'created in the V1 TbillMinter era',
    v2: 'created in the V2 FederalMinter era',
    'v3-bureau': 'created in the V3 IndexMinter + bureau era',
    v4: 'created in the V4 PersonalMinter era',
    'post-crisis': 'created after the 2025-04 pDAI/Maker crisis window',
    'long-tail': 'created 2025-07-01 → present (era ≠ minter version)',
    'old-atropa': 'the 2023–24 Maria #2 corpus window',
    'pre-v1': 'pre-V1 buildup (TBILL live → V1 minter)',
    'pre-fork': 'Ethereum-era entity, fork-carried at genesis',
    'treasury-window': 'the 2024-12 → 2025-02 treasury deployment window',
  };
  const LIQ_TIP: Record<string, string> = {
    'pooled-live': 'at least one pool with live reserves',
    'pooled-dead-all': 'pools exist, none live',
    'spine-only-paper': 'never had a pool',
  };
  const ORG_TIP: Record<string, string> = {
    core: 'Maria-authored standalone',
    'core-factory': 'factory child (core by construction)',
    external: 'fork-carried / bridge-wrapped / outside the ecosystem’s deployer keys',
  };
  const FLAG_TIP: Record<string, string> = {
    CANON: 'on the dev-published t-share list (alias only)',
    'burnt-locked-50': '≥50% of one pool\u2019s LP at dead sinks',
    'lp-parent': 'the parent token is itself a PulseX LP token',
  };
  const tipOf = (m: Record<string, string>, v: string): string =>
    ` title="${esc(m[v] ?? v)}"`;

  function render() {
    const start = page * PAGE;
    const slice = view.slice(start, start + PAGE);
    const frag = document.createDocumentFragment();
    for (const t of slice) {
      const tr = document.createElement('tr');
      const isTT = t.k === 'tt';
      let kvcell: string;
      if (isTT) {
        const vcls = t.v === 'V1' ? 'v1' : t.v === 'V2' ? 'v2' : t.v === 'V3' ? 'v3' : t.v === 'V4' ? 'v4' : 'br';
        const vlab = t.v === 'BureauMinter#1' ? 'BR' : t.v;
        kvcell = `<span class="badge ${vcls}"${tipOf(VER_TIP, t.v || '')}>${vlab}</span>`;
      } else {
        kvcell = `<span class="tag"${tipOf(K_TIP, t.k)}>${t.k}</span>`;
      }
      const flags: string[] = [];
      if (t.canon) flags.push(`<span class="badge canon"${tipOf(FLAG_TIP, 'CANON')}>CANON</span>`);
      for (const f of t.lf || []) flags.push(`<span class="badge"${tipOf(FLAG_TIP, f)}>${esc(f)}</span>`);
      const href = isTT ? `/tokens/${t.a}` : `/contracts/${t.a}`;
      tr.innerHTML =
        `<td class="clamped name wrapok" title="${esc(tip(t.n))}"><a href="${href}">${esc(clip(t.n, 72) || '—')}</a></td>` +
        `<td class="clamped sym" title="${esc(tip(t.s))}">${esc(clip(t.s, 20) || '—')}</td>` +
        `<td${tipOf(K_TIP, t.k)}>${kvcell}</td>` +
        `<td class="wrapok"><span class="tag"${tipOf(CLS_TIP, t.cls)}>${t.cls}</span> <span class="dim"${tipOf(ERA_TIP, t.era)}>${t.era}</span></td>` +
        `<td class="num">${fmt(t.sup, 0)}</td>` +
        `<td class="num">${t.mult != null ? t.mult + '×' : '—'}</td>` +
        `<td${tipOf(LIQ_TIP, t.liq)}>${t.liq}</td>` +
        `<td${tipOf(ORG_TIP, t.org)}>${t.org}</td>` +
        `<td>${bdate(t.ts)}</td>` +
        `<td>${flags.join('')}</td>` +
        (isTT
          ? `<td class="actcell"><a class="mono xs" href="/mint?token=${t.a}" title="mint-existing with live cost preview">mint</a> <a class="mono xs" href="/claim?token=${t.a}" title="claim eligibility verdict + publish">claim</a></td>`
          : `<td class="actcell dim">—</td>`);
      frag.appendChild(tr);
    }
    body.innerHTML = '';
    body.appendChild(frag);
    const pages = Math.max(1, Math.ceil(view.length / PAGE));
    countEl.textContent = `${view.length.toLocaleString()} rows`;
    pageEl.textContent = `page ${page + 1} / ${pages} (rows ${start + 1}–${Math.min(start + PAGE, view.length)})`;
    (document.getElementById('x-prev') as HTMLButtonElement).disabled = page === 0;
    (document.getElementById('x-next') as HTMLButtonElement).disabled = page >= pages - 1;
  }

  function apply(reset = true) {
    if (reset) page = 0;
    const q = (document.getElementById('x-q') as HTMLInputElement).value.trim().toLowerCase();
    const k = (document.getElementById('x-k') as HTMLSelectElement).value;
    const v = (document.getElementById('x-v') as HTMLSelectElement).value;
    const cls = (document.getElementById('x-cls') as HTMLSelectElement).value;
    const era = (document.getElementById('x-era') as HTMLSelectElement).value;
    const org = (document.getElementById('x-org') as HTMLSelectElement).value;
    const liq = (document.getElementById('x-liq') as HTMLSelectElement).value;
    let list = rows;
    if (q) list = list.filter((t) => (t.n || '').toLowerCase().includes(q) || (t.s || '').toLowerCase().includes(q) || t.a.includes(q));
    if (k) list = list.filter((t) => t.k === k);
    if (v) list = list.filter((t) => t.k === 'tt' && t.v === v);
    if (cls) list = list.filter((t) => t.cls === cls);
    if (era) list = list.filter((t) => t.era === era);
    if (org) list = list.filter((t) => t.org === org);
    if (liq === 'pooled-live' || liq === 'pooled-dead-all' || liq === 'spine-only-paper') list = list.filter((t) => t.liq === liq);
    else if (liq === 'burnt-locked-50') list = list.filter((t) => (t.lf || []).includes('burnt-locked-50'));
    const cmp: Record<string, (a: Row, b: Row) => number> = {
      n: (a, b) => (a.n || '').localeCompare(b.n || ''),
      s: (a, b) => (a.s || '').localeCompare(b.s || ''),
      k: (a, b) => (a.k || '').localeCompare(b.k || '') || (a.v || '').localeCompare(b.v || ''),
      cls: (a, b) => (a.cls || '').localeCompare(b.cls || '') || (a.era || '').localeCompare(b.era || ''),
      sup: (a, b) => (a.sup ?? 0) - (b.sup ?? 0),
      mult: (a, b) => (a.mult ?? 0) - (b.mult ?? 0),
      liq: (a, b) => (a.liq || '').localeCompare(b.liq || ''),
      org: (a, b) => (a.org || '').localeCompare(b.org || ''),
      ts: (a, b) => (a.ts ?? 0) - (b.ts ?? 0),
      flags: (a, b) => ((a.lf || []).length + (a.canon ? 1 : 0)) - ((b.lf || []).length + (b.canon ? 1 : 0)),
    };
    view = [...list];
    if (sortCol && cmp[sortCol]) {
      view.sort(cmp[sortCol]);
      if (sortDir === -1) view.reverse();
    } else {
      view.sort((a, b) => (a.ts ?? 0) - (b.ts ?? 0) || (a.blk ?? 0) - (b.blk ?? 0));
    }
    paintSortHeaders();
    render();
  }

  const xTable = document.getElementById('x-table') as HTMLTableElement;
  const COLTIP: Record<string, string> = {
    n: 'name — treasury children: onchain ERC-20 name() (offset-aware re-probe); registry tokens: curated registry label, fallback onchain name(); links to the entity page',
    s: 'sym — onchain ERC-20 symbol()',
    k: 'kind/ver — treasury children: factory generation (V1–V4, BR = Bureau#1); registry tokens: corpus kind (old-era, standalone, reserve, payment, shared-infra, affection, forked, bridge)',
    cls: 'class/era — taxonomy class (derived from mechanics, not community names) + era band; definitions on /knowledge/taxonomy/classes',
    sup: 'supply — totalSupply at the custody snapshot block (human units, treasury children only); not comparable across tokens as a ranking',
    mult: 'mult — live Multiplier() cost factor for mint() at the snapshot',
    liq: 'liquidity — pooled-live: ≥1 pool with live reserves · pooled-dead-all: all pools dead/empty · spine-only-paper: no pool ever; burnt-locked-50 flag = ≥50% of LP burnt',
    org: 'origin — core: Maria-authored standalone · core-factory: factory child (core by construction) · external: fork-carried/bridge-wrapped/outside',
    ts: 'created — creation-block timestamp (UTC date)',
    flags: 'flags — CANON = on the dev-published t-share list (alias only) + liquidity flags',
  };
  function paintSortHeaders() {
    for (const th of Array.from(xTable.tHead?.rows[0]?.cells ?? [])) {
      th.classList.remove('sort-asc', 'sort-desc');
      if (th.dataset.col === sortCol) th.classList.add(sortDir === 1 ? 'sort-asc' : 'sort-desc');
    }
  }
  for (const th of Array.from(xTable.tHead?.rows[0]?.cells ?? [])) {
      const col = th.dataset.col || '';
      th.setAttribute('title', `${COLTIP[col] ?? ''} — click to sort: asc → desc → default (creation date ascending)`.trim());
    th.addEventListener('click', () => {
      const col = th.dataset.col || '';
      if (sortCol === col) {
        if (sortDir === 1) sortDir = -1;
        else { sortCol = null; sortDir = 1; }
      } else {
        sortCol = col;
        sortDir = 1;
      }
      paintSortHeaders();
      apply(true);
    });
  }

  for (const id of ['x-q', 'x-k', 'x-v', 'x-cls', 'x-era', 'x-org', 'x-liq']) {
    document.getElementById(id)?.addEventListener('input', () => apply(true));
  }
  document.getElementById('x-prev')?.addEventListener('click', () => { if (page > 0) { page -= 1; render(); } });
  document.getElementById('x-next')?.addEventListener('click', () => { if (page < Math.ceil(view.length / PAGE) - 1) { page += 1; render(); } });

  document.getElementById('x-csv')?.addEventListener('click', () => {
    const esc = (v: unknown) => {
      const s = v === null || v === undefined ? '' : String(v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    };
    const header = ['address', 'kind', 'name', 'symbol', 'minter_version', 'class', 'era', 'origin', 'liquidity', 'liq_flags', 'block', 'timestamp', 'decimals', 'supply_human', 'multiplier_now', 'tshare_canon', 'parent'];
    const lines = [header.join(',')];
    for (const t of view) {
      lines.push([t.a, t.k, t.n, t.s, t.v ?? '', t.cls, t.era, t.org, t.liq, (t.lf || []).join('|'), t.blk, t.ts ? new Date(t.ts * 1000).toISOString().slice(0, 10) : '', t.d ?? '', t.sup ?? '', t.mult ?? '', t.canon ? 'true' : 'false', t.p || ''].map(esc).join(','));
    }
    const blob = new Blob([lines.join('\n') + '\n'], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'atropa-tokens-filtered.csv';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  fetch('/data/tokens_unified.compact.json')
    .then((r) => r.json())
    .then((d) => {
      rows = d.tokens;
      const q = new URLSearchParams(location.search);
      for (const [param, id] of [['k', 'x-k'], ['cls', 'x-cls'], ['era', 'x-era'], ['v', 'x-v'], ['org', 'x-org'], ['liq', 'x-liq']]) {
        const v = q.get(param);
        if (v) {
          const sel = document.getElementById(id) as HTMLSelectElement | null;
          if (sel && Array.from(sel.options).some((o) => o.value === v)) sel.value = v;
        }
      }
      const text = q.get('q');
      if (text) (document.getElementById('x-q') as HTMLInputElement).value = text;
      apply(true);
    })
    .catch((e) => {
      countEl.textContent = 'failed to load /data/tokens_unified.compact.json: ' + e;
    });
</script>
